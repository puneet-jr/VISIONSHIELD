# Environment variables; the app does not silently load this file.
HOST=0.0.0.0
PORT=8000
DEPLOYMENT_MODE=demo
# For a stable reverse proxy use a public HTTPS origin; --remote discovers a demo tunnel.
# PUBLIC_BASE_URL=https://your-domain.example
# Production must explicitly set a long random ACCESS_TOKEN.
# ACCESS_TOKEN=generate-at-least-32-random-characters
TRUST_LOCAL_DASHBOARD=true
ALLOWED_ORIGINS=[]
INFERENCE_BACKEND=auto
INPUT_SIZE=640
IDENTITY_RETENTION_SECONDS=120
IDENTITY_DISTANCE_THRESHOLD=0.10
IDENTITY_MATCH_MARGIN=0.04
REQUIRE_BAG_MONITOR_ZONE=true
EVIDENCE_RETENTION_DAYS=7
MAX_STORED_EVENTS=2000
STORE_EVENT_IMAGES=true
ENABLE_AI_DOSSIER=false
ENABLE_POSE=true
POSE_INTERVAL_SECONDS=0.75
POSE_MAX_AGE_SECONDS=1.5
# Immediate visual warnings. Persistent knife history still uses confidence/time gates.
ZONE_IMMEDIATE_WARNING=true
KNIFE_IMMEDIATE_WARNING=true
KNIFE_REQUIRE_PERSON=false
# Camera GPS is shared explicitly from the phone; installation coordinates and
# optional image-plane scale are entered in the dashboard's camera settings.

# Crowd cameras share a serial model worker; increase streams only after benchmarking.
MAX_CAMERA_STREAMS=4
MAX_DETECTIONS=250
CROWD_WARNING_SECONDS=2
CROWD_GROWTH_WINDOW_SECONDS=10
CROWD_GROWTH_THRESHOLD=0.30
CROWD_MIN_GROWTH=5
# Optional stable GUARD_TOKEN: generated per server start when unset. Keep private.

# Experimental head map: not promoted; current Mall counting results are worse.
ENABLE_HEAD_MAP=false
HEAD_MAP_TILED=false
HEAD_CONFIDENCE=0.35
